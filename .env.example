# Copy to .env and fill in. Values here are placeholders.

# ── Better Auth ──────────────────────────────────────────────────────
BETTER_AUTH_SECRET=generate-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# ── API + database ───────────────────────────────────────────────────
NEXT_PUBLIC_SERVER_URL=http://localhost:8000
MONGO_URI=mongodb://user:password@host1:27017,host2:27017/?replicaSet=...&tls=true&authSource=admin
# Must match the API's DB_NAME (default: DocAppoint).
DB_NAME=DocAppoint

# ── Google sign-in ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Cloudinary (uploads + f_auto,q_auto image delivery) ──────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email: sign-up codes and password resets are sent from this app ──
GMAIL_USER=
GMAIL_APP_PASSWORD=
